[Unit]
Description=Qdynn Telegram WEB relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qdynn
Group=qdynn
ExecStart=/usr/local/bin/qdynn-bridge --config-file /etc/qdynn/config.toml
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
