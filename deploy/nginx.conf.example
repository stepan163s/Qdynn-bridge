# Add inside nginx's http {} context. Replace proxy.example.com and certificate paths.
# Review alongside your existing virtual hosts; manage.sh never installs this file.
map $http_upgrade $qdynn_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 80;
    server_name proxy.example.com;
    # Issue/renew certificates using your existing ACME setup.
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    # Discard query strings on plaintext requests, including accidental credentials.
    location / { return 301 https://proxy.example.com$uri; }
    access_log off;
    error_log /var/log/nginx/qdynn-error.log crit;
}
server {
    listen 443 ssl;
    server_name proxy.example.com;
    ssl_certificate /etc/letsencrypt/live/proxy.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/proxy.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # URLs/subprotocols can carry credentials; no request logging for this vhost.
    access_log off;
    error_log /var/log/nginx/qdynn-error.log crit;
    client_max_body_size 2m;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $qdynn_connection_upgrade;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 100s;
        proxy_send_timeout 100s;
        proxy_connect_timeout 3s;
        proxy_cache off;
        # Preserve relay CSP and no-store. Do not add site-wide X-Frame-Options/CSP here.
    }
}
